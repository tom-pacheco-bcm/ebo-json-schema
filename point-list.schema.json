{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tom-pacheco-bcm.github.io/ebo-json-schema/point-list.schema.json",
  "title": "EBO Point List",
  "description": "EBO points for a project.",
  "type": "object",
  "required": ["controller_type", "points"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "url for the schema."
    },
    "controller_type": {
      "type": "string",
      "enum": ["bacnet", "server", "mpx"],
      "description": "Target controller system type used to resolve point type strings."
    },
    "points": {
      "type": "array",
      "description": "Classified EBO points, sorted alphabetically by name.",
      "items": {
        "$ref": "#/definitions/point"
      }
    }
  },
  "if": { "properties": { "controller_type": { "const": "bacnet" } } },
  "then": {
    "properties": {
      "points": {
        "items": {
          "properties": {
            "type": {
              "enum": [
                "bacnet.point.analog.Input",
                "bacnet.point.analog.Output",
                "bacnet.point.analog.Value",
                "bacnet.point.digital.Input",
                "bacnet.point.digital.Output",
                "bacnet.point.digital.Value",
                "bacnet.point.integer.Value",
                "bacnet.point.multistate.Input",
                "bacnet.point.multistate.Output",
                "bacnet.point.multistate.Value",
                "server.point.SV",
                "server.point.TS"
              ]
            }
          }
        }
      }
    }
  },
  "else": {
    "if": { "properties": { "controller_type": { "const": "server" } } },
    "then": {
      "properties": {
        "points": {
          "items": {
            "properties": {
              "type": {
                "enum": [
                  "server.point.AV",
                  "server.point.BV",
                  "server.point.IV",
                  "server.point.SV",
                  "server.point.TS",
                  "io.point.CounterInput",
                  "io.point.CurrentInput",
                  "io.point.CurrentOutput",
                  "io.point.DigitalInput",
                  "io.point.DigitalOutput",
                  "io.point.TemperatureInput",
                  "io.point.TristateOutput",
                  "io.point.VoltageInput",
                  "io.point.VoltageOutput"
                ]
              }
            }
          }
        }
      }
    },
    "else": {
      "properties": {
        "points": {
          "items": {
            "properties": {
              "type": {
                "enum": [
                  "bacnet.mpx.point.AirflowInput",
                  "bacnet.mpx.point.CounterInput",
                  "bacnet.mpx.point.CurrentInput",
                  "bacnet.mpx.point.CurrentOutput",
                  "bacnet.mpx.point.DamperOutput",
                  "bacnet.mpx.point.DigitalInput",
                  "bacnet.mpx.point.DigitalOutput",
                  "bacnet.mpx.point.DigitalPulsedOutput",
                  "bacnet.mpx.point.IntegerInput",
                  "bacnet.mpx.point.PulseWidthOutput",
                  "bacnet.mpx.point.ResistiveInput",
                  "bacnet.mpx.point.RTD2WireInput",
                  "bacnet.mpx.point.SupervisedInput",
                  "bacnet.mpx.point.TemperatureInput",
                  "bacnet.mpx.point.TristateOutput",
                  "bacnet.mpx.point.TristatePulsedOutput",
                  "bacnet.mpx.point.VoltageInput",
                  "bacnet.mpx.point.VoltageOutput",
                  "bacnet.mpx.value.AnalogConsumerValue",
                  "bacnet.mpx.value.AnalogProducerValue",
                  "bacnet.mpx.value.AnalogValue",
                  "bacnet.mpx.value.CharacterString",
                  "bacnet.mpx.value.DateTimeValue",
                  "bacnet.mpx.value.DigitalConsumerValue",
                  "bacnet.mpx.value.DigitalProducerValue",
                  "bacnet.mpx.value.DigitalValue",
                  "bacnet.mpx.value.IntegerConsumerValue",
                  "bacnet.mpx.value.IntegerProducerValue",
                  "bacnet.mpx.value.IntegerValue",
                  "bacnet.mpx.value.MultistateConsumerValue",
                  "bacnet.mpx.value.MultistateProducerValue",
                  "bacnet.mpx.value.MultistateValue",
                  "server.point.AV",
                  "server.point.BV",
                  "server.point.IV",
                  "server.point.SV",
                  "server.point.TS",
                  "io.point.CounterInput",
                  "io.point.CurrentInput",
                  "io.point.CurrentOutput",
                  "io.point.DigitalInput",
                  "io.point.DigitalOutput",
                  "io.point.TemperatureInput",
                  "io.point.TristateOutput",
                  "io.point.VoltageInput",
                  "io.point.VoltageOutput"
                ]
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "point": {
      "description": "A classified EBO point. Allowed optional properties depend on the point type.",
      "anyOf": [
        { "$ref": "#/definitions/point_analog_bacnet" },
        { "$ref": "#/definitions/point_integer_bacnet" },
        { "$ref": "#/definitions/point_digital_bacnet" },
        { "$ref": "#/definitions/point_multistate_bacnet" },
        { "$ref": "#/definitions/point_server" },
        { "$ref": "#/definitions/point_server_io" },
        { "$ref": "#/definitions/point_mpx_analog" },
        { "$ref": "#/definitions/point_mpx_analog_consumer" },
        { "$ref": "#/definitions/point_mpx_integer" },
        { "$ref": "#/definitions/point_mpx_integer_consumer" },
        { "$ref": "#/definitions/point_mpx_digital" },
        { "$ref": "#/definitions/point_mpx_digital_consumer" },
        { "$ref": "#/definitions/point_mpx_multistate" },
        { "$ref": "#/definitions/point_mpx_multistate_consumer" },
        { "$ref": "#/definitions/point_mpx_string" },
        { "$ref": "#/definitions/point_mpx_hardware_analog_input" },
        { "$ref": "#/definitions/point_mpx_hardware_analog_input_scaled" },
        { "$ref": "#/definitions/point_mpx_hardware_analog_output" },
        { "$ref": "#/definitions/point_mpx_hardware_binary_input" },
        { "$ref": "#/definitions/point_mpx_hardware_binary_output" }
      ]
    },

    "point_analog_bacnet": {
      "type": "object",
      "description": "BACnet analog point (bacnet.point.analog.*).",
      "required": ["name", "type", "setpoint"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Normalized point name, including any configured prefix."
        },
        "path": {
          "type": "string",
          "description": "Values directory where the point is located. Omitted for single-app projects."
        },
        "type": {
          "type": "string",
          "enum": [
            "bacnet.point.analog.Input",
            "bacnet.point.analog.Output",
            "bacnet.point.analog.Value"
          ]
        },
        "value": {
          "type": "string",
          "description": "Initial present value. Defaults to \"0\"."
        },
        "setpoint": {
          "type": "boolean",
          "description": "True when the point is classified as a Setpoint."
        },
        "DESCR": { "type": "string", "description": "Object description." },
        "MinPresValue": {
          "type": "string",
          "description": "Minimum present value."
        },
        "MaxPresValue": {
          "type": "string",
          "description": "Maximum present value."
        },
        "HighLimit": { "type": "string", "description": "High alarm limit." },
        "LowLimit": { "type": "string", "description": "Low alarm limit." },
        "LimitEnable": {
          "type": "string",
          "description": "Limit enable bits."
        },
        "NotificationClass": {
          "type": "string",
          "description": "BACnet alarm notification class."
        },
        "EventDetectionEnable": {
          "type": "string",
          "description": "Enable event detection."
        },
        "EventEnable": {
          "type": "string",
          "description": "Event transition enable bits."
        },
        "AlarmMessage": {
          "type": "string",
          "description": "Message text when alarm."
        },
        "ResetMessage": {
          "type": "string",
          "description": "Message text when reset."
        },
        "FaultMessage": {
          "type": "string",
          "description": "Message text when fault."
        }
      }
    },

    "point_integer_bacnet": {
      "type": "object",
